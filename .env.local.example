# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ==========================================
# AI SERVICES (Choose your preferred AI)
# ==========================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini
GOOGLE_GEMINI_API_KEY=your-google-gemini-key-here

# Claude (Anthropic)
CLAUDE_API_KEY=your-claude-key-here

# ==========================================
# PAYMENT GATEWAY
# ==========================================
STRIPE_PUBLIC_KEY=pk_live_your-stripe-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ==========================================
# EMAIL SERVICE
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@travelerp.com

# ==========================================
# SMS SERVICE (For Pakistan)
# ==========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# FILE STORAGE (Vercel Blob or AWS S3)
# ==========================================
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NEXT_PUBLIC_APP_NAME=Travel ERP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
NODE_ENV=development

# ==========================================
# DATABASE SETTINGS
# ==========================================
DATABASE_URL=your-database-url
NEXT_PUBLIC_DB_BACKUP=true

# ==========================================
# WEBHOOK URLS
# ==========================================
STRIPE_WEBHOOK_URL=http://localhost:3000/api/webhooks/stripe
PAYMENT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payment

# ==========================================
# GOOGLE SERVICES
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_SHEETS_API_KEY=your-google-sheets-key

# ==========================================
# EXTERNAL APIs
# ==========================================
WEATHER_API_KEY=your-weather-api-key
GDS_API_KEY=your-gds-api-key
HOTEL_API_KEY=your-hotel-booking-api-key

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this
ENCRYPTION_KEY=your-encryption-key-32-chars

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
SENTRY_DSN=your-sentry-dsn
POSTHOG_API_KEY=your-posthog-key

# ==========================================
# MULTI-TENANT SETTINGS
# ==========================================
MAX_BUSINESSES=50
TRIAL_DAYS=14
SUBSCRIPTION_CHECK_INTERVAL=3600

# ==========================================
# PWA & OFFLINE
# ==========================================
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_OFFLINE_SUPPORT=true
